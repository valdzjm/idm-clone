{
  "manifest_version": 3,
  "name": "Local Download Integration",
  "version": "0.4.0",
  "description": "Download direct videos, YouTube Shorts, Facebook and Instagram videos/reels, and supported website videos.",
  "web_accessible_resources": [{"resources":["media.js"],"matches":["http://*/*","https://*/*"]}],
  "permissions": [
    "nativeMessaging",
    "webRequest",
    "storage",
    "cookies",
    "contextMenus",
    "scripting"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "content_scripts": [
    {"matches":["https://*.facebook.com/*","https://facebook.com/*"],"js":["story-capture.js"],"run_at":"document_start","world":"MAIN"},
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Local Download Integration",
    "default_popup": "popup.html"
  },
  "key": ""
}
